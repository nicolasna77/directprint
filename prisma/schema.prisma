generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Better Auth models
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          String    @default("USER")
  plan          String    @default("FREE")

  sessions      Session[]
  accounts      Account[]
  documents     Document[]
  transactions  Transaction[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model Organization {
  id           String     @id @default(cuid())
  name         String
  type         OrgType
  address      String
  city         String
  zipCode      String
  printPointId String?
  printPoint   PrintPoint? @relation(fields: [printPointId], references: [id])
  createdAt    DateTime   @default(now())

  documents    Document[]

  @@unique([name, city])
}

model PrintPoint {
  id          String      @id @default(cuid())
  name        String
  address     String
  city        String
  zipCode     String
  latitude    Float
  longitude   Float
  status      PrintStatus @default(ONLINE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  organizations Organization[]
  documents     Document[]
}

model Document {
  id           String     @id @default(cuid())
  userId       String
  orgId        String
  printPointId String?
  fileName     String
  fileUrl      String
  pages        Int        @default(1)
  price        Float
  status       DocStatus  @default(PENDING)
  trackingCode String     @unique @default(cuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deliveredAt  DateTime?

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])
  printPoint   PrintPoint?  @relation(fields: [printPointId], references: [id])
  transaction  Transaction?
}

model Transaction {
  id              String            @id @default(cuid())
  userId          String
  documentId      String            @unique
  amount          Float
  status          TransactionStatus @default(PENDING)
  stripePaymentId String?
  createdAt       DateTime          @default(now())

  user     User     @relation(fields: [userId], references: [id])
  document Document @relation(fields: [documentId], references: [id])
}

enum OrgType {
  MAIRIE
  CAF
  CPAM
  PREFECTURE
  POLE_EMPLOI
  IMPOTS
  TRIBUNAL
  AUTRE
}

enum PrintStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum DocStatus {
  PENDING
  PROCESSING
  ROUTING
  PRINTING
  DELIVERED
  FAILED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}
